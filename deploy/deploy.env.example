# Copy to deploy/deploy.env on the VPS and edit. Both scripts source it.
#
#   cp deploy/deploy.env.example deploy/deploy.env && nano deploy/deploy.env
#
# deploy.env is git-ignored: it never leaves the server.

# The domain you are pointing at this VPS. Required. No https://, no slash.
DOMAIN=trezuh.com

# Also serve www.<domain> and redirect it to the bare domain.
WITH_WWW=1

# --- everything below is namespaced so it cannot collide with anything ---
# --- else already running on this box. Change only if it does.        ---

APP_NAME=trezuh
APP_PORT=3100
APP_DIR=/var/www/trezuh
REPO=https://github.com/itsmearyanabc/trezuh-website-.git
BRANCH=main
