# The canonical origin. Used for metadata, canonical links, robots.txt,
# sitemap.xml and the structured data. Set this to the live domain before the
# production build — it is read at build time, not at runtime.
NEXT_PUBLIC_SITE_URL=https://trezuh.com

# Optional. The content value of Google Search Console's HTML-tag
# verification, e.g. NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=abc123...
# Leave unset until Search Console gives you one.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
